# ND-100 register operations (ROP): SWAP, RAND, REXO, RORA, RADD (and the aliases COPY, RSUB, RINC, RDCR, RCLR, EXIT).
#
# Word layout:  1 1 0 0 1 x x x | CM1 CLD | sr(3) | dr(3)   (bits 15-8: 0xC8 SWAP, C9 RAND, CA REXO, CB RORA, CC-CE RADD)
# Register numbers: 0 = "0" (reads as zero; a write is lost), 1 D, 2 P, 3 B, 4 L, 5 A, 6 T, 7 X.
# During the execution of an instruction P already points to the next instruction, so P as a source reads inst_next;
# a result written to P is a jump.
# Modifiers: CLD uses zero instead of the destination as an operand, CM1 uses the 1's complement of the source.

rsrc: "0"  is rop_src=0 { local z:2 = 0; export z; }
rsrc: "SD" is rop_src=1 { export D; }
rsrc: "SP" is rop_src=2 { local nx:4 = inst_next; local p:2 = nx:2 >> 1; export p; }
rsrc: "SB" is rop_src=3 { export B; }
rsrc: "SL" is rop_src=4 { export L; }
rsrc: "SA" is rop_src=5 { export A; }
rsrc: "ST" is rop_src=6 { export T; }
rsrc: "SX" is rop_src=7 { export X; }

rdst: "0"  is rop_dst=0 { local z:2 = 0; export z; }
rdst: "DD" is rop_dst=1 { export D; }
rdst: "DP" is rop_dst=2 { export P; }
rdst: "DB" is rop_dst=3 { export B; }
rdst: "DL" is rop_dst=4 { export L; }
rdst: "DA" is rop_dst=5 { export A; }
rdst: "DT" is rop_dst=6 { export T; }
rdst: "DX" is rop_dst=7 { export X; }

# the destination as an operand (read): P reads as the address of the next instruction
rdstr: "0"  is rop_dst=0 { local z:2 = 0; export z; }
rdstr: "DD" is rop_dst=1 { export D; }
rdstr: "DP" is rop_dst=2 { local nx:4 = inst_next; local p:2 = nx:2 >> 1; export p; }
rdstr: "DB" is rop_dst=3 { export B; }
rdstr: "DL" is rop_dst=4 { export L; }
rdstr: "DA" is rop_dst=5 { export A; }
rdstr: "DT" is rop_dst=6 { export T; }
rdstr: "DX" is rop_dst=7 { export X; }

rmod: ""        is rop_cm1=0 & rop_cld=0 { }
rmod: " CLD"    is rop_cm1=0 & rop_cld=1 { }
rmod: " CM1"    is rop_cm1=1 & rop_cld=0 { }
rmod: " CM1 CLD" is rop_cm1=1 & rop_cld=1 { }

radmod: ""     is rop_ad=0 { }
radmod: " AD1" is rop_ad=1 { }
radmod: " ADC" is rop_ad=2 { }

# the operands of a register operation after the modifiers: d = (CLD ? 0 : dr), s = (CM1 ? ~sr : sr)
macro RopOperands(d, s, dr, sr, cld, cm1) {
	d = dr;
	if (cld == 0) goto <dok>;
	d = 0;
	<dok>
	s = sr;
	if (cm1 == 0) goto <sok>;
	s = ~s;
	<sok>
}

:RADD^radmod^rmod rsrc rdst is op5=0x19 & X_bit=1 & radmod & rmod & rsrc & rdst & rdstr & rop_ad & rop_cm1 & rop_cld & rop_dnum {
	local cld:1 = rop_cld;
	local cm1:1 = rop_cm1;
	local dsel:1 = rop_dnum;
	local ad:1 = rop_ad;
	local d:2 = 0;
	local s:2 = 0;
	RopOperands(d, s, rdstr, rsrc, cld, cm1);
	local addend:2 = 0;
	if (ad == 0) goto <noad>;
	addend = 1;
	if (ad == 1) goto <noad>;
	addend = zext(STS[6,1]);
	<noad>
	local tmp:4 = zext(d) + zext(s) + zext(addend);
	local r:2 = tmp:2;
	STS[6,1] = (tmp >> 16) != 0;
	local ovf:1 = ((d >> 15) == (s >> 15)) && ((r >> 15) != (d >> 15));
	STS[4,1] = ovf;
	STS[5,1] = STS[5,1] | ovf;
	rdst = r;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:RAND^rmod rsrc rdst is op8=0xC9 & rmod & rsrc & rdst & rdstr & rop_cm1 & rop_cld & rop_dnum {
	local cld:1 = rop_cld;
	local cm1:1 = rop_cm1;
	local dsel:1 = rop_dnum;
	local d:2 = 0;
	local s:2 = 0;
	RopOperands(d, s, rdstr, rsrc, cld, cm1);
	rdst = d & s;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:REXO^rmod rsrc rdst is op8=0xCA & rmod & rsrc & rdst & rdstr & rop_cm1 & rop_cld & rop_dnum {
	local cld:1 = rop_cld;
	local cm1:1 = rop_cm1;
	local dsel:1 = rop_dnum;
	local d:2 = 0;
	local s:2 = 0;
	RopOperands(d, s, rdstr, rsrc, cld, cm1);
	rdst = d ^ s;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:RORA^rmod rsrc rdst is op8=0xCB & rmod & rsrc & rdst & rdstr & rop_cm1 & rop_cld & rop_dnum {
	local cld:1 = rop_cld;
	local cm1:1 = rop_cm1;
	local dsel:1 = rop_dnum;
	local d:2 = 0;
	local s:2 = 0;
	RopOperands(d, s, rdstr, rsrc, cld, cm1);
	rdst = d | s;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

# SWAP: the destination receives the (CM1: complemented) source, the source receives the (CLD: cleared) destination
:SWAP^rmod rsrc rdst is op8=0xC8 & rmod & rsrc & rdst & rdstr & rop_cm1 & rop_cld & rop_dnum {
	local cld:1 = rop_cld;
	local cm1:1 = rop_cm1;
	local dsel:1 = rop_dnum;
	local d:2 = 0;
	local s:2 = 0;
	RopOperands(d, s, rdstr, rsrc, cld, cm1);
	rdst = s;
	rsrc = d;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

# SKP IF dr cond sr: skip the next instruction if the condition on the flags of (dr) - (sr) holds
skpcond: "EQL"  is skp_cond=0 { }
skpcond: "GEQ"  is skp_cond=1 { }
skpcond: "GRE"  is skp_cond=2 { }
skpcond: "MGRE" is skp_cond=3 { }
skpcond: "UEQ"  is skp_cond=4 { }
skpcond: "LSS"  is skp_cond=5 { }
skpcond: "LST"  is skp_cond=6 { }
skpcond: "MLST" is skp_cond=7 { }

:SKP "IF" rdstr skpcond rsrc^" "^skip_next is op5=0x18 & skp_fixed=0x0 & skpcond & rdstr & rsrc & rop_src & rop_dst & skp_cond & skip_next {
	local d:2 = rdstr;
	local s:2 = rsrc;
	local diff:2 = d - s;
	local cond:1 = skp_cond;
	local neg:1 = diff s< 0;
	local zero:1 = diff == 0;
	local ovf:1 = sborrow(d, s);
	local uge:1 = d >= s;
	local take:1 = 0;
	if (cond != 0) goto <c1>;
	take = zero; goto <go>;
	<c1>
	if (cond != 1) goto <c2>;
	take = !neg; goto <go>;
	<c2>
	if (cond != 2) goto <c3>;
	take = !(neg ^ ovf); goto <go>;
	<c3>
	if (cond != 3) goto <c4>;
	take = uge; goto <go>;
	<c4>
	if (cond != 4) goto <c5>;
	take = !zero; goto <go>;
	<c5>
	if (cond != 5) goto <c6>;
	take = neg; goto <go>;
	<c6>
	if (cond != 6) goto <c7>;
	take = neg ^ ovf; goto <go>;
	<c7>
	take = !uge;
	<go>
	if (take == 0) goto inst_next;
	goto skip_next;
}

# RMPY sr, dr: A:D = (dr) * (sr), signed. Computed like the hardware (sign and magnitude): the product is formed from the
# magnitudes and negated when exactly one operand is negative; that negation sets C when the low word of the magnitude is 0
# and the dynamic overflow flag (bit 4) when it is 0x8000 (that also sets the static one, bit 5); both are cleared otherwise.
# A positive product leaves the flags alone. (Fitted to, and checked
# against, 469 operand pairs of nd100x.)
:RMPY rsrc rdst is op10=0x30A & rsrc & rdst & rdstr & rop_src & rop_dst {
	local x:2 = rdstr;
	local y:2 = rsrc;
	local neg:1 = ((x >> 15) ^ (y >> 15)) != 0;
	local mx:4 = zext(x);
	if (x s>= 0) goto <xpos>;
	mx = zext(-x);
	<xpos>
	local my:4 = zext(y);
	if (y s>= 0) goto <ypos>;
	my = zext(-y);
	<ypos>
	local mag:4 = mx * my;
	local result:4 = mag;
	if (neg == 0) goto <store>;
	result = -mag;
	local lo:2 = mag:2;
	STS[6,1] = (lo == 0);
	STS[4,1] = (lo == 0x8000);
	if (lo != 0x8000) goto <store>;
	STS[5,1] = 1;
	<store>
	A = result(2);
	D = result:2;
}

# RDIV sr: A:D / (sr), signed; quotient to A, remainder to D. Also sign and magnitude: a negative dividend is negated first
# (same C / overflow-flag rule as RMPY on its low word), the magnitudes are divided, the quotient is negative when the signs
# differ, the remainder has the sign of the dividend. Z (STS bit 3) is set when the divisor is 0 or the quotient does not fit
# a signed 16-bit word; when the high word of the magnitude is not below the divisor (also divisor 0) A:D = (high - divisor,
# low) and nothing else changes. Checked against 1445 cases of nd100x.
:RDIV rsrc is op10=0x30E & rsrc & rop_src & rop_dst {
	local dv:2 = rsrc;
	local dneg:1 = (A s< 0);
	local full:4 = (zext(A) << 16) | zext(D);
	if (dneg == 0) goto <posdividend>;
	full = -full;
	STS[6,1] = (D == 0);
	STS[4,1] = (D == 0x8000);
	if (D != 0x8000) goto <posdividend>;
	STS[5,1] = 1;
	<posdividend>
	local mh:2 = full(2);
	local ml:2 = full:2;
	local dm:2 = dv;
	if (dv s>= 0) goto <dpos>;
	dm = -dv;
	<dpos>
	if (mh < dm) goto <divide>;
	STS[3,1] = 1;
	A = mh - dm;
	D = ml;
	goto <done>;
	<divide>
	local qm:4 = full / zext(dm);
	local rm:4 = full % zext(dm);
	local qneg:1 = (dneg != (dv s< 0));
	local q:2 = qm:2;
	local r:2 = rm:2;
	if (qneg == 0) goto <qpos>;
	if (qm <= 0x8000) goto <qok>;
	STS[3,1] = 1;
	<qok>
	q = -q;
	goto <rsign>;
	<qpos>
	if (qm <= 0x7FFF) goto <rsign>;
	STS[3,1] = 1;
	<rsign>
	if (dneg == 0) goto <rdone>;
	r = -r;
	<rdone>
	A = q;
	D = r;
	<done>
}

# RSUB sr, dr: RADD CM1 AD1 (dr <- dr - sr); the assembler name of that combination
rsubmod: "" is rop_ad=1 { }
:RSUB rsrc rdst is op5=0x19 & X_bit=1 & rop_ad=1 & rop_cm1=1 & rop_cld=0 & rsrc & rdst & rdstr & rop_src & rop_dnum {
	local dsel:1 = rop_dnum;
	local d:2 = rdstr;
	local s:2 = ~rsrc;
	local tmp:4 = zext(d) + zext(s) + 1;
	local r:2 = tmp:2;
	STS[6,1] = (tmp >> 16) != 0;
	local ovf:1 = ((d >> 15) == (s >> 15)) && ((r >> 15) != (d >> 15));
	STS[4,1] = ovf;
	STS[5,1] = STS[5,1] | ovf;
	rdst = r;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

# ---------------------------------------------------------------------------------------------------------------------
# Shifts: SHT (T), SHD (D), SHA (A), SAD (A:D, 32 bits).  Word: 1 1 0 1 1 | type(2) | reg(2) | x | count(6)
#   type 0: arithmetic (zero in on a left shift, the sign on a right shift), 1: ROT (rotate), 2: ZIN (zero in),
#           3: LIN (the link bit M is shifted in)
#   count: 6 bits, two's complement: 1..31 shift left, 33..63 shift right by 64 - count; 0 and 32 do nothing.
#   M (STS bit 7) receives the bit shifted out last. Verified against all 6144 combinations of word and operand
#   (type, register, direction, every count, M = 0 and 1) of nd100x.
# v: operand (zero extended), w: width in bits, n: number of steps (1..31), right: 0/1, m0: M before the shift
# ---------------------------------------------------------------------------------------------------------------------
macro ShiftOp(v, w, typ, n, right, m0, outv, mnew) {
	local mask:8 = (1 << w) - 1;
	local nm:8 = n % w;
	local fillbit:8 = 0;
	if (right != 0) goto <rightshift>;
	if (typ != 1) goto <leftlin>;
	outv = v;
	if (nm == 0) goto <leftrot_m>;
	outv = ((v << nm) | (v >> (w - nm))) & mask;
	<leftrot_m>
	mnew = (v >> ((w - nm) % w)) & 1;
	goto <done>;
	<leftlin>
	if (typ != 3) goto <leftfill>;
	fillbit = m0;
	<leftfill>
	outv = ((v << n) & mask);
	if (fillbit == 0) goto <leftm>;
	outv = outv | (((1 << n) - 1) & mask);
	<leftm>
	mnew = fillbit;
	if (n > w) goto <done>;
	mnew = (v >> (w - n)) & 1;
	goto <done>;
	<rightshift>
	if (typ != 1) goto <rightlin>;
	outv = v;
	if (nm == 0) goto <rightrot_m>;
	outv = ((v >> nm) | (v << (w - nm))) & mask;
	<rightrot_m>
	mnew = (v >> ((n - 1) % w)) & 1;
	goto <done>;
	<rightlin>
	if (typ != 0) goto <rl_notsign>;
	fillbit = (v >> (w - 1)) & 1;
	<rl_notsign>
	if (typ != 3) goto <rl_nolink>;
	fillbit = m0;
	<rl_nolink>
	outv = v >> n;
	if (fillbit == 0) goto <rightm>;
	local ones:8 = mask;
	if (n >= w) goto <rl_ones>;
	ones = mask & ~(mask >> n);
	<rl_ones>
	outv = outv | ones;
	<rightm>
	mnew = fillbit;
	if (n > w) goto <done>;
	mnew = (v >> (n - 1)) & 1;
	<done>
}

:SHT shift_operand is op5=0x1B & shift_reg=0x0 & shift_operand & shift_type & shift_cnt6 {
	local cnt:8 = shift_cnt6;
	local typ:8 = shift_type;
	local m0:8 = zext(STS[7,1]);
	if (cnt == 0 || cnt == 32) goto <done>;
	local right:8 = cnt >> 5;
	local n:8 = cnt;
	if (right == 0) goto <go>;
	n = 64 - cnt;
	<go>
	local v:8 = zext(T);
	local outv:8 = 0;
	local mnew:8 = 0;
	ShiftOp(v, 16:8, typ, n, right, m0, outv, mnew);
	T = outv:2;
	STS[7,1] = mnew:1;
	<done>
}

:SHD shift_operand is op5=0x1B & shift_reg=0x1 & shift_operand & shift_type & shift_cnt6 {
	local cnt:8 = shift_cnt6;
	local typ:8 = shift_type;
	local m0:8 = zext(STS[7,1]);
	if (cnt == 0 || cnt == 32) goto <done>;
	local right:8 = cnt >> 5;
	local n:8 = cnt;
	if (right == 0) goto <go>;
	n = 64 - cnt;
	<go>
	local v:8 = zext(D);
	local outv:8 = 0;
	local mnew:8 = 0;
	ShiftOp(v, 16:8, typ, n, right, m0, outv, mnew);
	D = outv:2;
	STS[7,1] = mnew:1;
	<done>
}

:SHA shift_operand is op5=0x1B & shift_reg=0x2 & shift_operand & shift_type & shift_cnt6 {
	local cnt:8 = shift_cnt6;
	local typ:8 = shift_type;
	local m0:8 = zext(STS[7,1]);
	if (cnt == 0 || cnt == 32) goto <done>;
	local right:8 = cnt >> 5;
	local n:8 = cnt;
	if (right == 0) goto <go>;
	n = 64 - cnt;
	<go>
	local v:8 = zext(A);
	local outv:8 = 0;
	local mnew:8 = 0;
	ShiftOp(v, 16:8, typ, n, right, m0, outv, mnew);
	A = outv:2;
	STS[7,1] = mnew:1;
	<done>
}

:SAD shift_operand is op5=0x1B & shift_reg=0x3 & shift_operand & shift_type & shift_cnt6 {
	local cnt:8 = shift_cnt6;
	local typ:8 = shift_type;
	local m0:8 = zext(STS[7,1]);
	if (cnt == 0 || cnt == 32) goto <done>;
	local right:8 = cnt >> 5;
	local n:8 = cnt;
	if (right == 0) goto <go>;
	n = 64 - cnt;
	<go>
	local v:8 = (zext(A) << 16) | zext(D);
	local outv:8 = 0;
	local mnew:8 = 0;
	ShiftOp(v, 32:8, typ, n, right, m0, outv, mnew);
	A = outv[16,16];
	D = outv:2;
	STS[7,1] = mnew:1;
	<done>
}

# ---------------------------------------------------------------------------------------------------------------------
# Bit operations (174000-177777): word = 1 1 1 1 | op(4) 7 bits... = op9 | bit(4) | reg(3)
#   operand register 0 is the status register STS (the bit number then names a flag: 2 = K, 3 = Z, 4 = Q, 5 = O, 6 = C, 7 = M),
#   1 D, 2 P, 3 B, 4 L, 5 A, 6 T, 7 X. P reads as the address of the next instruction; a modified P is a jump.
#   K is STS bit 2 (the one-bit accumulator).
#     BSET ZRO/ONE/BCM/BAC  bit <- 0 / 1 / complement / K
#     BSKP ZRO/ONE/BCM/BAC  skip the next instruction if bit = 0 / bit = 1 / bit != K / bit = K
#     BSTC bit <- not K, K <- 1      BSTA bit <- K, K <- 0
#     BLDC K <- not bit              BLDA K <- bit
#     BANC K <- K and not bit        BAND K <- K and bit
#     BORC K <- K or not bit         BORA K <- K or bit
#   Checked against all 16 operations x bit x register value x K of nd100x and 142+150 random programs.
# ---------------------------------------------------------------------------------------------------------------------
bregr: "0"  is rop_dst=0 { export STS; }
bregr: "DD" is rop_dst=1 { export D; }
bregr: "DP" is rop_dst=2 { local nx:4 = inst_next; local p:2 = nx:2 >> 1; export p; }
bregr: "DB" is rop_dst=3 { export B; }
bregr: "DL" is rop_dst=4 { export L; }
bregr: "DA" is rop_dst=5 { export A; }
bregr: "DT" is rop_dst=6 { export T; }
bregr: "DX" is rop_dst=7 { export X; }

bregw: "0"  is rop_dst=0 { export STS; }
bregw: "DD" is rop_dst=1 { export D; }
bregw: "DP" is rop_dst=2 { export P; }
bregw: "DB" is rop_dst=3 { export B; }
bregw: "DL" is rop_dst=4 { export L; }
bregw: "DA" is rop_dst=5 { export A; }
bregw: "DT" is rop_dst=6 { export T; }
bregw: "DX" is rop_dst=7 { export X; }

:BSET "ZRO "^bit4^" "^bregw is op9=0x1f0 & bit4 & bregr & bregw & rop_dnum {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	local nv:2 = v & ~m;
	bregw = nv;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:BSET "ONE "^bit4^" "^bregw is op9=0x1f1 & bit4 & bregr & bregw & rop_dnum {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	local nv:2 = v | m;
	bregw = nv;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:BSET "BCM "^bit4^" "^bregw is op9=0x1f2 & bit4 & bregr & bregw & rop_dnum {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	local nv:2 = v ^ m;
	bregw = nv;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:BSET "BAC "^bit4^" "^bregw is op9=0x1f3 & bit4 & bregr & bregw & rop_dnum {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	local nv:2 = v & ~m;
	if (k == 0) goto <st>;
	nv = v | m;
	<st>
	bregw = nv;
	if (dsel != 2) goto <nojump>;
	goto [P];
	<nojump>
}

:BSKP "ZRO "^bit4^" "^bregw^" "^skip_next is op9=0x1f4 & bit4 & bregr & bregw & rop_dnum & skip_next {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	if (b != 0) goto <no>;
	goto skip_next;
	<no>
}

:BSKP "ONE "^bit4^" "^bregw^" "^skip_next is op9=0x1f5 & bit4 & bregr & bregw & rop_dnum & skip_next {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	if (b == 0) goto <no>;
	goto skip_next;
	<no>
}

:BSKP "BCM "^bit4^" "^bregw^" "^skip_next is op9=0x1f6 & bit4 & bregr & bregw & rop_dnum & skip_next {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
	local k:1 = STS[2,1];
	local b:1 = ((v & m) != 0);
	if (b == k) goto <no>;
	goto skip_next;
	<no>
}

:BSKP "BAC "^bit4^" "^bregw^" "^skip_next is op9=0x1f7 & bit4 & bregr & bregw & rop_dnum & skip_next {
	local m:2 = 1 << bit4;
	local dsel:1 = rop_dnum;
	local v:2 = bregr;
