    # 146400 octal = 0xCD00, 13-bit mask
    STS[5,1] = scarry(reg3, 1);            # O = signed overflow on increment
    STS[4,1] = STS[4,1] | STS[5,1];       # Q = sticky overflow
    STS[6,1] = carry(reg3, 1);             # C = unsigned carry
    reg3 = reg3 + 1;                       # Increment destination register