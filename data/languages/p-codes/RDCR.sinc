    # 146200 octal = 0xCC80, 13-bit mask
    STS[5,1] = sborrow(reg3, 1);           # O = signed overflow on decrement
    STS[4,1] = STS[4,1] | STS[5,1];       # Q = sticky overflow
    STS[6,1] = (reg3 != 0);               # C = no borrow
    reg3 = reg3 - 1;                       # Decrement destination register